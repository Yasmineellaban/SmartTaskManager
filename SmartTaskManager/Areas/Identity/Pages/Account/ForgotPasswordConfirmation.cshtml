@page
@model ForgotPasswordConfirmation

@{
ViewData["Title"] = "Password Reset";
}

<div class="password-confirmation-page">

<div class="password-confirmation-card">

    <div class="confirmation-icon">
        <i class="bi bi-envelope-check"></i>
    </div>

    <span class="confirmation-eyebrow">
        PASSWORD RESET
    </span>

    <h1>Check Your Email</h1>

    <p>
        We've sent instructions to your email address
        to reset your password.
    </p>

    <div class="confirmation-note">
        <i class="bi bi-info-circle"></i>

        <span>
            If you don't see the email, check your spam
            or junk folder.
        </span>
    </div>

    <a asp-page="./Login"
       class="btn btn-primary back-button">

        <i class="bi bi-arrow-left"></i>
        Back to Login

    </a>

</div>


</div>

<style>

    .password-confirmation-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }

    .password-confirmation-card {
        width: 100%;
        max-width: 450px;

        padding: 42px 35px;

        text-align: center;

        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }

    .confirmation-icon {
        width: 68px;
        height: 68px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: var(--green-100);
        color: var(--green-700);

        font-size: 28px;
    }

    .confirmation-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }

    .password-confirmation-card h1 {
        margin: 0 0 10px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;
    }

    .password-confirmation-card > p {
        max-width: 320px;

        margin: 0 auto 22px;

        color: var(--text-muted);

        font-size: 12px;
        line-height: 1.7;
    }

    .confirmation-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;

        margin-bottom: 24px;
        padding: 13px 14px;

        border-radius: 12px;

        background: var(--green-50);
        color: var(--text-muted);

        font-size: 10px;
        line-height: 1.6;

        text-align: left;
    }

    .confirmation-note i {
        margin-top: 1px;

        color: var(--green-600);

        font-size: 14px;
        flex-shrink: 0;
    }

    .back-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 11px 18px;

        border-radius: 11px;

        font-size: 11px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .password-confirmation-page {
            min-height: calc(100vh - 120px);
            padding: 25px 15px;
        }

        .password-confirmation-card {
            padding: 35px 25px;
        }

    }

</style>
