@page
@model ConfirmEmailChangeModel

@{
ViewData["Title"] = "Confirm Email Change";
}

<div class="confirm-change-page">

<div class="confirm-change-card">

    <div class="confirm-change-icon">
        <i class="bi bi-envelope-check"></i>
    </div>

    <span class="confirm-change-eyebrow">
        ACCOUNT SETTINGS
    </span>

    <h1>Confirm Email Change</h1>

    <p>
        Your email change confirmation status is shown below.
    </p>

    <div class="status-wrapper">
        <partial name="_StatusMessage"
                 model="Model.StatusMessage" />
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        <i class="bi bi-house"></i>
        Back to Home
    </a>

</div>


</div>

<style>

    .confirm-change-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }

    .confirm-change-card {
        width: 100%;
        max-width: 460px;

        padding: 42px 35px;

        text-align: center;

        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }

    .confirm-change-icon {
        width: 68px;
        height: 68px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: var(--green-100);
        color: var(--green-700);

        font-size: 28px;
    }

    .confirm-change-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }

    .confirm-change-card h1 {
        margin: 0 0 10px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;
    }

    .confirm-change-card > p {
        max-width: 320px;

        margin: 0 auto 24px;

        color: var(--text-muted);

        font-size: 12px;
        line-height: 1.7;
    }

    .status-wrapper {
        text-align: left;
        margin-bottom: 20px;
    }

    .status-wrapper .status-message {
        margin-bottom: 0;
    }

    .confirm-change-card .btn {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 11px 18px;

        border-radius: 11px;

        font-size: 11px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .confirm-change-page {
            min-height: calc(100vh - 120px);
            padding: 25px 15px;
        }

        .confirm-change-card {
            padding: 35px 25px;
        }

    }

</style>
