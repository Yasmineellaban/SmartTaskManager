@page
@model LockoutModel

@{
ViewData["Title"] = "Account Locked";
}

<div class="lockout-page">


<div class="lockout-card">

    <div class="lockout-icon">
        <i class="bi bi-lock"></i>
    </div>

    <span class="lockout-eyebrow">
        SECURITY NOTICE
    </span>

    <h1>Account Locked</h1>

    <p>
        This account has been temporarily locked.
        Please try again later.
    </p>

    <div class="lockout-note">

        <i class="bi bi-shield-exclamation"></i>

        <span>
            For your security, sign-in is temporarily unavailable.
        </span>

    </div>

    <a asp-page="./Login"
       class="btn btn-primary lockout-button">

        <i class="bi bi-arrow-left"></i>
        Back to Login

    </a>

</div>


</div>

<style>

    .lockout-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }

    .lockout-card {
        width: 100%;
        max-width: 450px;

        padding: 42px 35px;

        text-align: center;

        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }

    .lockout-icon {
        width: 68px;
        height: 68px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: #fff1ef;
        color: #b65346;

        font-size: 28px;
    }

    .lockout-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: #b65346;

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }

    .lockout-card h1 {
        margin: 0 0 10px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;
    }

    .lockout-card > p {
        max-width: 320px;

        margin: 0 auto 22px;

        color: var(--text-muted);

        font-size: 12px;
        line-height: 1.7;
    }

    .lockout-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;

        margin-bottom: 24px;
        padding: 13px 14px;

        border-radius: 12px;

        background: #fff7f5;
        color: #806b67;

        font-size: 10px;
        line-height: 1.6;

        text-align: left;
    }

    .lockout-note i {
        margin-top: 1px;

        color: #b65346;

        font-size: 14px;
        flex-shrink: 0;
    }

    .lockout-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 11px 18px;

        border-radius: 11px;

        font-size: 11px;
        font-weight: 700;
    }

    @@media (max-width: 767px) {

        .lockout-page {
            min-height: calc(100vh - 120px);
            padding: 25px 15px;
        }

        .lockout-card {
            padding: 35px 25px;
        }

    }

</style>
