@page
@model ResetPasswordModel

@{
ViewData["Title"] = "Reset Password";
}

<div class="reset-password-page">


<div class="reset-password-card">

    <div class="reset-icon">
        <i class="bi bi-shield-lock"></i>
    </div>

    <span class="reset-eyebrow">
        ACCOUNT SECURITY
    </span>

    <h1>Create a New Password</h1>

    <p>
        Enter your email address and choose a new password
        for your account.
    </p>


    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"
             role="alert"></div>


        <input asp-for="Input.Code"
               type="hidden" />


        <div class="form-field">

            <label asp-for="Input.Email">
                Email Address
            </label>

            <div class="input-wrapper">

                <i class="bi bi-envelope"></i>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

            </div>

            <span asp-validation-for="Input.Email"
                  class="text-danger"></span>

        </div>


        <div class="form-field">

            <label asp-for="Input.Password">
                New Password
            </label>

            <div class="input-wrapper">

                <i class="bi bi-lock"></i>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Enter your new password" />

            </div>

            <span asp-validation-for="Input.Password"
                  class="text-danger"></span>

        </div>


        <div class="form-field">

            <label asp-for="Input.ConfirmPassword">
                Confirm New Password
            </label>

            <div class="input-wrapper">

                <i class="bi bi-shield-check"></i>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirm your new password" />

            </div>

            <span asp-validation-for="Input.ConfirmPassword"
                  class="text-danger"></span>

        </div>


        <button type="submit"
                class="btn btn-primary reset-button">

            <i class="bi bi-check2-circle"></i>
            Reset Password

        </button>

    </form>


    <div class="security-note">

        <i class="bi bi-shield-check"></i>

        <span>
            Choose a strong password that you don't use
            on other accounts.
        </span>

    </div>


    <a asp-page="./Login"
       class="back-login">

        <i class="bi bi-arrow-left"></i>
        Back to Login

    </a>

</div>


</div>

<style>

    .reset-password-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }


    .reset-password-card {
        width: 100%;
        max-width: 450px;

        padding: 42px 35px;

        text-align: center;

        background: var(--surface);

        border: 1px solid var(--border);

        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }


    .reset-icon {
        width: 66px;
        height: 66px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 19px;

        background: var(--green-100);

        color: var(--green-700);

        font-size: 27px;
    }


    .reset-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }


    .reset-password-card h1 {
        margin: 0 0 10px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;
    }


    .reset-password-card > p {
        max-width: 325px;

        margin: 0 auto 25px;

        color: var(--text-muted);

        font-size: 12px;

        line-height: 1.7;
    }


    .form-field {
        margin-bottom: 18px;

        text-align: left;
    }


    .form-field label {
        display: block;

        margin-bottom: 8px;

        color: var(--text-main);

        font-size: 11px;
        font-weight: 650;
    }


    .input-wrapper {
        position: relative;
    }


    .input-wrapper > i {
        position: absolute;

        left: 14px;
        top: 50%;

        transform: translateY(-50%);

        color: var(--text-muted);

        font-size: 14px;

        pointer-events: none;

        z-index: 2;
    }


    .input-wrapper .form-control {
        width: 100%;

        min-height: 45px;

        padding: 11px 14px 11px 40px;

        border: 1px solid var(--border);

        border-radius: 12px;

        background: var(--surface-soft);

        color: var(--text-main);

        font-family: inherit;

        font-size: 12px;

        transition: var(--transition);
    }


    .input-wrapper .form-control::placeholder {
        color: #9aaba4;
    }


    .input-wrapper .form-control:focus {
        border-color: var(--green-400);

        background: var(--surface);

        box-shadow:
            0 0 0 4px rgba(32, 184, 122, 0.10);

        outline: none;
    }


    .input-wrapper:focus-within > i {
        color: var(--green-600);
    }


    .text-danger {
        display: block;

        margin-top: 5px;

        color: #c45145;

        font-size: 10px;
    }


    .validation-summary {
        margin-bottom: 18px;

        padding: 12px 14px;

        border-radius: 12px;

        background: #fff1ef;

        color: #a64c3c;

        font-size: 10px;

        text-align: left;
    }


    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none;
    }


    .reset-button {
        width: 100%;

        min-height: 46px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        margin-top: 3px;

        border-radius: 12px;

        font-size: 11px;
        font-weight: 700;
    }


    .security-note {
        display: flex;

        align-items: flex-start;

        gap: 9px;

        margin-top: 21px;

        padding: 13px 14px;

        border-radius: 12px;

        background: var(--green-50);

        color: var(--text-muted);

        font-size: 9px;

        line-height: 1.6;

        text-align: left;
    }


    .security-note i {
        margin-top: 1px;

        color: var(--green-600);

        font-size: 13px;

        flex-shrink: 0;
    }


    .back-login {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        margin-top: 21px;

        color: var(--text-muted);

        font-size: 10px;
        font-weight: 600;

        text-decoration: none;

        transition: var(--transition);
    }


    .back-login:hover {
        color: var(--green-700);

        gap: 9px;
    }


    @@media (max-width: 767px) {

        .reset-password-page {
            min-height: calc(100vh - 120px);

            padding: 25px 15px;
        }


        .reset-password-card {
            padding: 35px 25px;
        }


        .reset-password-card h1 {
            font-size: 23px;
        }

    }

</style>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
