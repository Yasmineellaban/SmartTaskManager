@page
@model ResetPasswordConfirmationModel

@{
ViewData["Title"] = "Password Reset";
}

<div class="reset-confirmation-page">


<div class="reset-confirmation-card">

    <div class="success-icon">
        <i class="bi bi-check2-circle"></i>
    </div>

    <span class="success-eyebrow">
        PASSWORD UPDATED
    </span>

    <h1>Password Reset Successfully</h1>

    <p>
        Your password has been reset successfully.
        You can now sign in using your new password.
    </p>

    <a asp-page="./Login"
       class="btn btn-primary login-button">

        <i class="bi bi-box-arrow-in-right"></i>
        Log In

    </a>

</div>


</div>

<style>

    .reset-confirmation-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }


    .reset-confirmation-card {
        width: 100%;
        max-width: 450px;

        padding: 42px 35px;

        text-align: center;

        background: var(--surface);

        border: 1px solid var(--border);

        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }


    .success-icon {
        width: 68px;
        height: 68px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: var(--green-100);

        color: var(--green-700);

        font-size: 29px;
    }


    .success-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }


    .reset-confirmation-card h1 {
        margin: 0 0 10px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;
    }


    .reset-confirmation-card p {
        max-width: 320px;

        margin: 0 auto 25px;

        color: var(--text-muted);

        font-size: 12px;

        line-height: 1.7;
    }


    .login-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        min-width: 145px;

        padding: 11px 20px;

        border-radius: 11px;

        font-size: 11px;
        font-weight: 700;
    }


    @@media (max-width: 767px) {

        .reset-confirmation-page {
            min-height: calc(100vh - 120px);

            padding: 25px 15px;
        }


        .reset-confirmation-card {
            padding: 35px 25px;
        }


        .reset-confirmation-card h1 {
            font-size: 23px;
        }

    }

</style>
