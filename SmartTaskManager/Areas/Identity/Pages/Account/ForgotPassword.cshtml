@page
@model ForgotPasswordModel

@{
ViewData["Title"] = "Forgot Password";
}

<div class="forgot-password-page">


<div class="forgot-password-card">

    <div class="forgot-icon">
        <i class="bi bi-key"></i>
    </div>

    <span class="forgot-eyebrow">
        ACCOUNT SECURITY
    </span>

    <h1>Forgot Password?</h1>

    <p>
        Enter the email address associated with your account
        and we'll help you reset your password.
    </p>

    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"
             role="alert"></div>

        <div class="form-field">

            <label asp-for="Input.Email">
                Email Address
            </label>

            <input asp-for="Input.Email"
                   class="form-control"
                   autocomplete="username"
                   aria-required="true"
                   placeholder="name@example.com" />

            <span asp-validation-for="Input.Email"
                  class="text-danger"></span>

        </div>

        <button type="submit"
                class="btn btn-primary reset-button">

            <i class="bi bi-arrow-repeat"></i>
            Reset Password

        </button>

    </form>

    <a asp-page="./Login"
       class="back-login">

        <i class="bi bi-arrow-left"></i>
        Back to Login

    </a>

</div>


</div>

<style>

    .forgot-password-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }

    .forgot-password-card {
        width: 100%;
        max-width: 450px;

        padding: 42px 35px;

        text-align: center;

        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }

    .forgot-icon {
        width: 66px;
        height: 66px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 19px;

        background: var(--green-100);
        color: var(--green-700);

        font-size: 27px;
    }

    .forgot-eyebrow {
        display: block;

        margin-bottom: 8px;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }

    .forgot-password-card h1 {
        margin: 0 0 10px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;
    }

    .forgot-password-card > p {
        max-width: 330px;

        margin: 0 auto 25px;

        color: var(--text-muted);

        font-size: 12px;
        line-height: 1.7;
    }

    .form-field {
        margin-bottom: 20px;

        text-align: left;
    }

    .form-field label {
        display: block;

        margin-bottom: 8px;

        color: var(--text-main);

        font-size: 12px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;

        padding: 12px 14px;

        border: 1px solid var(--border);
        border-radius: 12px;

        background: var(--surface-soft);
        color: var(--text-main);

        font-size: 13px;

        transition: var(--transition);
    }

    .form-control:focus {
        border-color: var(--green-400);
        background: var(--surface);

        box-shadow:
            0 0 0 4px rgba(32, 184, 122, 0.10);

        outline: none;
    }

    .text-danger {
        display: block;

        margin-top: 5px;

        color: #c45145;

        font-size: 11px;
    }

    .validation-summary {
        margin-bottom: 18px;

        padding: 12px 14px;

        border-radius: 12px;

        background: #fff1ef;

        color: #a64c3c;

        font-size: 11px;

        text-align: left;
    }

    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none;
    }

    .reset-button {
        width: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 12px 18px;

        border-radius: 11px;

        font-size: 11px;
        font-weight: 700;
    }

    .back-login {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        margin-top: 22px;

        color: var(--green-700);

        font-size: 11px;
        font-weight: 600;

        text-decoration: none;

        transition: var(--transition);
    }

    .back-login:hover {
        color: var(--green-900);
        gap: 9px;
    }

    @@media (max-width: 767px) {

        .forgot-password-page {
            min-height: calc(100vh - 120px);
            padding: 25px 15px;
        }

        .forgot-password-card {
            padding: 35px 25px;
        }

    }

</style>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
