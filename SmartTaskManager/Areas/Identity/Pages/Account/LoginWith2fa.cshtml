@page
@model LoginWith2faModel

@{
ViewData["Title"] = "Two-Factor Authentication";
}

<div class="two-factor-page">


<div class="two-factor-card">

    <div class="two-factor-icon">
        <i class="bi bi-shield-lock"></i>
    </div>

    <span class="two-factor-eyebrow">
        SECURITY VERIFICATION
    </span>

    <h1>Two-Factor Authentication</h1>

    <p class="two-factor-description">
        Your login is protected with an authenticator app.
        Enter the verification code below to continue.
    </p>


    <form method="post"
          asp-route-returnUrl="@Model.ReturnUrl">

        <input asp-for="RememberMe"
               type="hidden" />


        <div asp-validation-summary="ModelOnly"
             class="validation-summary"
             role="alert"></div>


        <div class="form-field">

            <label asp-for="Input.TwoFactorCode">
                Authenticator Code
            </label>

            <div class="code-input-wrapper">

                <i class="bi bi-shield-check"></i>

                <input asp-for="Input.TwoFactorCode"
                       class="form-control code-input"
                       autocomplete="off"
                       inputmode="numeric"
                       placeholder="Enter your code" />

            </div>

            <span asp-validation-for="Input.TwoFactorCode"
                  class="text-danger"></span>

        </div>


        <div class="remember-machine">

            <label asp-for="Input.RememberMachine"
                   class="remember-label">

                <input asp-for="Input.RememberMachine"
                       class="form-check-input" />

                <span>
                    @Html.DisplayNameFor(
                        m => m.Input.RememberMachine)
                </span>

            </label>

        </div>


        <button type="submit"
                class="btn btn-primary verify-button">

            <i class="bi bi-check2-circle"></i>

            Verify & Log In

        </button>

    </form>


    <div class="recovery-section">

        <div class="recovery-icon">
            <i class="bi bi-key"></i>
        </div>

        <div class="recovery-content">

            <strong>Can't access your authenticator?</strong>

            <span>
                Use one of your recovery codes instead.
            </span>

            <a id="recovery-code-login"
               asp-page="./LoginWithRecoveryCode"
               asp-route-returnUrl="@Model.ReturnUrl">

                Log in with a recovery code
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</div>


</div>

<style>

    .two-factor-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
    }


    .two-factor-card {
        width: 100%;
        max-width: 470px;

        padding: 42px 38px;

        background: var(--surface);

        border: 1px solid var(--border);

        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }


    .two-factor-icon {
        width: 68px;
        height: 68px;

        margin: 0 auto 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: var(--green-100);

        color: var(--green-700);

        font-size: 28px;
    }


    .two-factor-eyebrow {
        display: block;

        margin-bottom: 8px;

        text-align: center;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }


    .two-factor-card h1 {
        margin: 0 0 10px;

        text-align: center;

        color: var(--text-main);

        font-size: 24px;
        font-weight: 750;
    }


    .two-factor-description {
        max-width: 340px;

        margin: 0 auto 26px;

        text-align: center;

        color: var(--text-muted);

        font-size: 11px;

        line-height: 1.7;
    }


    .form-field {
        margin-bottom: 17px;
    }


    .form-field label {
        display: block;

        margin-bottom: 8px;

        color: var(--text-main);

        font-size: 11px;
        font-weight: 650;
    }


    .code-input-wrapper {
        position: relative;
    }


    .code-input-wrapper > i {
        position: absolute;

        left: 14px;
        top: 50%;

        transform: translateY(-50%);

        color: var(--text-muted);

        font-size: 15px;

        pointer-events: none;

        z-index: 2;
    }


    .code-input {
        width: 100%;

        min-height: 48px;

        padding: 12px 14px 12px 41px;

        border: 1px solid var(--border);

        border-radius: 12px;

        background: var(--surface-soft);

        color: var(--text-main);

        font-size: 14px;

        letter-spacing: 2px;

        transition: var(--transition);
    }


    .code-input::placeholder {
        color: #9aaba4;

        letter-spacing: 0;
    }


    .code-input:focus {
        border-color: var(--green-400);

        background: var(--surface);

        box-shadow:
            0 0 0 4px rgba(32, 184, 122, 0.10);

        outline: none;
    }


    .code-input-wrapper:focus-within > i {
        color: var(--green-600);
    }


    .text-danger {
        display: block;

        margin-top: 5px;

        color: #c45145;

        font-size: 10px;
    }


    .validation-summary {
        margin-bottom: 18px;

        padding: 12px 14px;

        border-radius: 12px;

        background: #fff1ef;

        color: #a64c3c;

        font-size: 10px;
    }


    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none;
    }


    .remember-machine {
        margin-bottom: 20px;
    }


    .remember-label {
        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin: 0;

        color: var(--text-muted);

        font-size: 10px;

        cursor: pointer;
    }


    .remember-label .form-check-input {
        width: 15px;
        height: 15px;

        margin: 0;

        border: 1px solid rgba(12, 91, 62, 0.18);

        cursor: pointer;
    }


    .remember-label .form-check-input:checked {
        background-color: var(--green-600);

        border-color: var(--green-600);
    }


    .verify-button {
        width: 100%;

        min-height: 46px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        border-radius: 12px;

        font-size: 11px;
        font-weight: 700;
    }


    .recovery-section {
        display: flex;

        align-items: flex-start;

        gap: 12px;

        margin-top: 25px;

        padding: 15px;

        border: 1px solid var(--border);

        border-radius: 14px;

        background: var(--green-50);
    }


    .recovery-icon {
        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: var(--green-100);

        color: var(--green-700);

        font-size: 14px;
    }


    .recovery-content {
        display: flex;

        flex-direction: column;

        gap: 3px;
    }


    .recovery-content strong {
        color: var(--text-main);

        font-size: 10px;
        font-weight: 700;
    }


    .recovery-content span {
        color: var(--text-muted);

        font-size: 9px;

        line-height: 1.5;
    }


    .recovery-content a {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        margin-top: 5px;

        color: var(--green-700);

        font-size: 10px;
        font-weight: 700;

        text-decoration: none;

        transition: var(--transition);
    }


    .recovery-content a:hover {
        color: var(--green-900);

        gap: 7px;
    }


    .recovery-content a i {
        font-size: 9px;
    }


    @@media (max-width: 767px) {

        .two-factor-page {
            min-height: calc(100vh - 120px);

            padding: 25px 15px;
        }


        .two-factor-card {
            padding: 35px 25px;
        }


        .two-factor-card h1 {
            font-size: 22px;
        }

    }

</style>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
