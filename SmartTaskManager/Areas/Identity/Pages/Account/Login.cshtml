@page
@model LoginModel

@{
ViewData["Title"] = "Log in";
}

<div class="login-page">


<div class="login-card">

    <div class="login-brand">
        <div class="login-logo">
            <i class="bi bi-check2-square"></i>
        </div>

        <div>
            <strong>SmartTask</strong>
            <span>Manager</span>
        </div>
    </div>


    <div class="login-heading">

        <span class="login-eyebrow">
            WELCOME BACK
        </span>

        <h1>Sign in to your workspace</h1>

        <p>
            Continue managing your tasks and stay productive.
        </p>

    </div>


    <form id="account"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"
             role="alert"></div>


        <div class="form-field">

            <label asp-for="Input.Email">
                Email Address
            </label>

            <div class="input-wrapper">

                <i class="bi bi-envelope"></i>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

            </div>

            <span asp-validation-for="Input.Email"
                  class="text-danger"></span>

        </div>


        <div class="form-field">

            <div class="password-label-row">

                <label asp-for="Input.Password">
                    Password
                </label>

                <a id="forgot-password"
                   asp-page="./ForgotPassword">
                    Forgot password?
                </a>

            </div>

            <div class="input-wrapper">

                <i class="bi bi-lock"></i>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your password" />

            </div>

            <span asp-validation-for="Input.Password"
                  class="text-danger"></span>

        </div>


        <div class="remember-row">

            <label asp-for="Input.RememberMe"
                   class="remember-label">

                <input class="form-check-input"
                       asp-for="Input.RememberMe" />

                <span>
                    @Html.DisplayNameFor(
                        m => m.Input.RememberMe)
                </span>

            </label>

        </div>


        <button id="login-submit"
                type="submit"
                class="btn btn-primary login-button">

            <span>Sign In</span>

            <i class="bi bi-arrow-right"></i>

        </button>


        <div class="login-links">

            <span>Don't have an account?</span>

            <a asp-page="./Register"
               asp-route-returnUrl="@Model.ReturnUrl">
                Create an account
            </a>

        </div>


        <div class="login-links secondary-link">

            <a id="resend-confirmation"
               asp-page="./ResendEmailConfirmation">

                <i class="bi bi-envelope-arrow-up"></i>
                Resend email confirmation

            </a>

        </div>

    </form>


    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="divider">

            <span>OR CONTINUE WITH</span>

        </div>


        <form id="external-account"
              asp-page="./ExternalLogin"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <div class="external-buttons">

                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="external-button"
                            name="provider"
                            value="@provider.Name"
                            title="Log in using your @provider.DisplayName account">

                        <i class="bi bi-box-arrow-in-right"></i>

                        <span>
                            Continue with @provider.DisplayName
                        </span>

                    </button>
                }

            </div>

        </form>
    }

</div>


</div>

<style>

    .login-page {
        min-height: calc(100vh - 180px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 35px 20px;
    }


    .login-card {
        width: 100%;
        max-width: 480px;

        padding: 38px 40px;

        background: var(--surface);

        border: 1px solid var(--border);

        border-radius: var(--radius-xl);

        box-shadow: var(--shadow-lg);
    }


    .login-brand {
        display: flex;
        align-items: center;
        gap: 11px;

        margin-bottom: 32px;
    }


    .login-logo {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background: var(--green-700);
        color: white;

        font-size: 19px;

        box-shadow:
            0 7px 18px rgba(11, 138, 91, 0.18);
    }


    .login-brand strong {
        display: block;

        color: var(--text-main);

        font-size: 13px;
        font-weight: 800;
        line-height: 1.1;
    }


    .login-brand span {
        display: block;

        color: var(--green-600);

        font-size: 9px;
        font-weight: 600;

        letter-spacing: 0.4px;
    }


    .login-heading {
        margin-bottom: 27px;
    }


    .login-eyebrow {
        display: block;

        margin-bottom: 7px;

        color: var(--green-700);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }


    .login-heading h1 {
        margin: 0 0 9px;

        color: var(--text-main);

        font-size: 25px;
        font-weight: 750;

        line-height: 1.25;
    }


    .login-heading p {
        margin: 0;

        color: var(--text-muted);

        font-size: 11px;

        line-height: 1.6;
    }


    .form-field {
        margin-bottom: 19px;
    }


    .form-field label {
        display: block;

        margin-bottom: 8px;

        color: var(--text-main);

        font-size: 11px;
        font-weight: 650;
    }


    .password-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 8px;
    }


    .password-label-row label {
        margin-bottom: 0;
    }


    .password-label-row a {
        color: var(--green-700);

        font-size: 10px;
        font-weight: 600;

        text-decoration: none;

        transition: var(--transition);
    }


    .password-label-row a:hover {
        color: var(--green-900);
    }


    .input-wrapper {
        position: relative;
    }


    .input-wrapper > i {
        position: absolute;

        left: 14px;
        top: 50%;

        transform: translateY(-50%);

        color: var(--text-muted);

        font-size: 14px;

        pointer-events: none;

        z-index: 2;
    }


    .input-wrapper .form-control {
        width: 100%;

        min-height: 45px;

        padding: 11px 14px 11px 40px;

        border: 1px solid var(--border);

        border-radius: 12px;

        background: var(--surface-soft);

        color: var(--text-main);

        font-family: inherit;

        font-size: 12px;

        transition: var(--transition);
    }


    .input-wrapper .form-control::placeholder {
        color: #9aaba4;
    }


    .input-wrapper .form-control:focus {
        border-color: var(--green-400);

        background: var(--surface);

        box-shadow:
            0 0 0 4px rgba(32, 184, 122, 0.10);

        outline: none;
    }


    .input-wrapper:focus-within > i {
        color: var(--green-600);
    }


    .text-danger {
        display: block;

        margin-top: 5px;

        color: #c45145;

        font-size: 10px;
    }


    .validation-summary {
        margin-bottom: 18px;

        padding: 12px 14px;

        border-radius: 12px;

        background: #fff1ef;

        color: #a64c3c;

        font-size: 10px;

        text-align: left;
    }


    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none;
    }


    .remember-row {
        margin-bottom: 20px;
    }


    .remember-label {
        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin: 0;

        color: var(--text-muted);

        font-size: 10px;

        cursor: pointer;
    }


    .remember-label .form-check-input {
        width: 15px;
        height: 15px;

        margin: 0;

        border: 1px solid rgba(12, 91, 62, 0.18);

        cursor: pointer;
    }


    .remember-label .form-check-input:checked {
        background-color: var(--green-600);
        border-color: var(--green-600);
    }


    .login-button {
        width: 100%;

        min-height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        border-radius: 12px;

        font-size: 11px;
        font-weight: 700;

        transition: var(--transition);
    }


    .login-button i {
        transition: var(--transition);
    }


    .login-button:hover i {
        transform: translateX(3px);
    }


    .login-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;

        margin-top: 19px;

        color: var(--text-muted);

        font-size: 10px;
    }


    .login-links a {
        color: var(--green-700);

        font-weight: 700;

        text-decoration: none;
    }


    .login-links a:hover {
        color: var(--green-900);
    }


    .secondary-link {
        margin-top: 12px;
    }


    .secondary-link a {
        display: inline-flex;

        align-items: center;

        gap: 6px;

        color: var(--text-muted);

        font-weight: 500;
    }


    .secondary-link a:hover {
        color: var(--green-700);
    }


    .divider {
        position: relative;

        display: flex;
        align-items: center;

        margin: 28px 0 18px;
    }


    .divider::before,
    .divider::after {
        content: "";

        flex: 1;

        height: 1px;

        background: var(--border);
    }


    .divider span {
        padding: 0 12px;

        color: var(--text-muted);

        font-size: 8px;
        font-weight: 700;

        letter-spacing: 1px;
    }


    .external-buttons {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }


    .external-button {
        width: 100%;

        min-height: 43px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        border: 1px solid var(--border);

        border-radius: 11px;

        background: var(--surface-soft);

        color: var(--text-main);

        font-family: inherit;

        font-size: 10px;
        font-weight: 600;

        cursor: pointer;

        transition: var(--transition);
    }


    .external-button i {
        color: var(--green-700);

        font-size: 14px;
    }


    .external-button:hover {
        border-color: var(--green-300);

        background: var(--green-50);

        transform: translateY(-1px);

        box-shadow: var(--shadow-sm);
    }


    @@media (max-width: 767px) {

        .login-page {
            min-height: calc(100vh - 120px);

            padding: 25px 15px;
        }


        .login-card {
            padding: 32px 24px;
        }


        .login-heading h1 {
            font-size: 23px;
        }

    }

</style>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
