<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartTaskManager</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartTaskManager.styles.css"
          asp-append-version="true" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <div class="app-shell">

        <!-- Sidebar -->

        <aside class="app-sidebar">

            <div class="brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="brand-link">

                    <div class="brand-logo">
                        <i class="bi bi-check2"></i>
                    </div>

                    <div class="brand-text">
                        <span class="brand-name">SmartTask</span>
                        <span class="brand-subtitle">Manager</span>
                    </div>

                </a>

            </div>


            <div class="sidebar-content">

                <div class="sidebar-section">

                    <span class="sidebar-label">
                        WORKSPACE
                    </span>


                    <a class="sidebar-item"
                       asp-controller="Dashboard"
                       asp-action="Index">

                        <span class="sidebar-icon">
                            <i class="bi bi-grid-1x2-fill"></i>
                        </span>

                        <span>Dashboard</span>

                    </a>


                    <a class="sidebar-item"
                       asp-controller="Tasks"
                       asp-action="Index">

                        <span class="sidebar-icon">
                            <i class="bi bi-check2-square"></i>
                        </span>

                        <span>My Tasks</span>

                    </a>


                    <a class="sidebar-item"
                       asp-controller="Categories"
                       asp-action="Index">

                        <span class="sidebar-icon">
                            <i class="bi bi-folder2-open"></i>
                        </span>

                        <span>Categories</span>

                    </a>


                    <a class="sidebar-item"
                       asp-controller="Calendar"
                       asp-action="Index">

                        <span class="sidebar-icon">
                            <i class="bi bi-calendar3"></i>
                        </span>

                        <span>Calendar</span>

                    </a>

                </div>


                <div class="sidebar-section ai-section">

                    <span class="sidebar-label">
                        INTELLIGENCE
                    </span>


                    <a class="sidebar-item ai-item"
                       asp-controller="AI"
                       asp-action="Index">

                        <span class="sidebar-icon">
                            <i class="bi bi-stars"></i>
                        </span>

                        <span>AI Assistant</span>

                        <span class="ai-dot"></span>

                    </a>


                    <a class="sidebar-item ai-item"
                       asp-controller="Agent"
                       asp-action="Index">

                        <span class="sidebar-icon">
                            <i class="bi bi-robot"></i>
                        </span>

                        <span>AI Agent</span>

                        <span class="ai-dot"></span>

                    </a>

                </div>

            </div>


            <!-- User Area -->

            <div class="sidebar-user">

                <partial name="_LoginPartial" />

            </div>

        </aside>


        <!-- Main Application -->

        <div class="app-main">

            <!-- Top Bar -->

            <header class="app-topbar">

                <div class="topbar-title">

                    <span class="topbar-eyebrow">
                        SMART WORKSPACE
                    </span>

                    <h1>
                        @ViewData["Title"]
                    </h1>

                </div>


                <div class="topbar-decoration">

                    <div class="status-indicator">

                        <span class="status-dot"></span>

                        <span>System Online</span>

                    </div>

                </div>

            </header>


            <!-- Page Content -->

            <main class="app-content">

                <div class="page-container">

                    @RenderBody()

                </div>

            </main>


            <!-- Footer -->

            <footer class="app-footer">

                <span>
                    © 2026 SmartTaskManager
                </span>

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

            </footer>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>