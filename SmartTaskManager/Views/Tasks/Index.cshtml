@model IEnumerable<SmartTaskManager.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
}

<div class="tasks-page">

    <!-- Page Header -->
    <div class="tasks-header">

        <div>
            <span class="tasks-eyebrow">
                WORKSPACE
            </span>

            <h2>
                My Tasks
            </h2>

            <p>
                Organize your work and keep track of everything that matters.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary create-task-btn">

            <i class="bi bi-plus-lg"></i>

            Create Task

        </a>

    </div>


    <!-- Filters -->
    <div class="tasks-filter-panel">

        <form asp-action="Index"
              method="get">

            <div class="filter-grid">

                <!-- Search -->
                <div class="filter-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search tasks..." />

                </div>


                <!-- Status -->
                <select name="status"
                        class="task-filter-select">

                    <option value="">
                        All Statuses
                    </option>

                    @foreach (var status in Enum.GetValues<SmartTaskManager.Models.TaskStatus>())
                    {
                        <option value="@status"
                                selected="@(ViewBag.Status == status)">
                            @status
                        </option>
                    }

                </select>


                <!-- Priority -->
                <select name="priority"
                        class="task-filter-select">

                    <option value="">
                        All Priorities
                    </option>

                    @foreach (var priority in Enum.GetValues<SmartTaskManager.Models.TaskPriority>())
                    {
                        <option value="@priority"
                                selected="@(ViewBag.Priority == priority)">
                            @priority
                        </option>
                    }

                </select>


                <!-- Category -->
                <select name="categoryId"
                        class="task-filter-select">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id"
                                selected="@(ViewBag.CategoryId == category.Id)">
                            @category.Name
                        </option>
                    }

                </select>


                <!-- Actions -->
                <div class="filter-actions">

                    <button type="submit"
                            class="btn btn-primary filter-btn">

                        <i class="bi bi-funnel"></i>

                        Filter

                    </button>

                    <a asp-action="Index"
                       class="clear-filter-btn">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Clear

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Tasks Header -->
    <div class="tasks-list-header">

        <div>
            <span class="tasks-list-eyebrow">
                TASKS
            </span>

            <h3>
                Your Tasks
            </h3>
        </div>

        <span class="task-count">
            @Model.Count() @(Model.Count() == 1 ? "task" : "tasks")
        </span>

    </div>


    <!-- Tasks -->
    @if (!Model.Any())
    {
        <div class="tasks-empty-state">

            <div class="empty-task-icon">
                <i class="bi bi-check2-square"></i>
            </div>

            <h3>
                No tasks found
            </h3>

            <p>
                Try changing your filters or create a new task.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>

                Create Your First Task

            </a>

        </div>
    }
    else
    {
        <div class="tasks-grid">

            @foreach (var task in Model)
            {
                <a asp-action="Details"
                   asp-route-id="@task.Id"
                   class="task-card">

                    <div class="task-card-top">

                        <div class="task-status-icon
                                    status-@task.Status.ToString().ToLower()">

                            @if (task.Status == SmartTaskManager.Models.TaskStatus.Completed)
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else if (task.Status == SmartTaskManager.Models.TaskStatus.InProgress)
                            {
                                <i class="bi bi-arrow-repeat"></i>
                            }
                            else if (task.Status == SmartTaskManager.Models.TaskStatus.Cancelled)
                            {
                                <i class="bi bi-x-lg"></i>
                            }
                            else
                            {
                                <i class="bi bi-clock"></i>
                            }

                        </div>


                        <span class="task-priority
                                     priority-@task.Priority.ToString().ToLower()">

                            @task.Priority

                        </span>

                    </div>


                    <div class="task-card-body">

                        <h4>
                            @task.Title
                        </h4>

                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <p>
                                @task.Description
                            </p>
                        }
                        else
                        {
                            <p class="no-description">
                                No description
                            </p>
                        }

                    </div>


                    <div class="task-card-footer">

                        <span class="task-status-text">

                            @task.Status

                        </span>


                        @if (task.DueDate.HasValue)
                        {
                            <span class="task-due-date">

                                <i class="bi bi-calendar3"></i>

                                @task.DueDate.Value.ToString("MMM dd, yyyy")

                            </span>
                        }
                        else
                        {
                            <span class="task-due-date muted">

                                No due date

                            </span>
                        }

                    </div>


                    <div class="task-card-arrow">

                        <i class="bi bi-arrow-up-right"></i>

                    </div>

                </a>
            }

        </div>
    }

</div>


<style>

    /* ==============================
       Tasks Page
    ============================== */

    .tasks-page {
        width: 100%;
    }


    /* ==============================
       Header
    ============================== */

    .tasks-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 25px;

        margin-bottom: 28px;
    }


    .tasks-eyebrow,
    .tasks-list-eyebrow {
        display: block;

        color: var(--green-700);

        font-size: 10px;
        font-weight: 800;

        letter-spacing: 1.8px;
    }


    .tasks-header h2 {
        margin: 7px 0 5px;

        color: var(--green-950);

        font-size: 34px;
        font-weight: 800;

        letter-spacing: -1px;
    }


    .tasks-header p {
        margin: 0;

        color: var(--text-muted);

        font-size: 13px;
    }


    .create-task-btn {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        padding: 12px 18px;

        white-space: nowrap;
    }


    /* ==============================
       Filter Panel
    ============================== */

    .tasks-filter-panel {
        margin-bottom: 38px;

        padding: 18px;

        border-radius: 20px;

        background:
            rgba(255, 255, 255, 0.88);

        border: 1px solid var(--border);

        box-shadow: var(--shadow-sm);

        backdrop-filter: blur(12px);
    }


    .filter-grid {
        display: grid;

        grid-template-columns:
            minmax(220px, 1.6fr)
            minmax(150px, 1fr)
            minmax(150px, 1fr)
            minmax(150px, 1fr)
            auto;

        gap: 10px;

        align-items: center;
    }


    .filter-search {
        position: relative;
    }


    .filter-search i {
        position: absolute;

        left: 14px;
        top: 50%;

        transform: translateY(-50%);

        color: var(--text-muted);

        font-size: 14px;

        pointer-events: none;
    }


    .filter-search input {
        width: 100%;

        height: 44px;

        padding:
            0 14px 0 40px;

        border-radius: 12px;

        border:
            1px solid rgba(12, 91, 62, 0.13);

        background: var(--surface-soft);

        color: var(--text-main);

        outline: none;

        font-family: inherit;

        font-size: 12px;

        transition: var(--transition);
    }


    .filter-search input:focus {
        border-color: var(--green-500);

        background: white;

        box-shadow:
            0 0 0 4px rgba(32, 184, 122, 0.10);
    }


    .task-filter-select {
        width: 100%;

        height: 44px;

        padding: 0 12px;

        border-radius: 12px;

        border:
            1px solid rgba(12, 91, 62, 0.13);

        background: var(--surface-soft);

        color: var(--text-main);

        font-family: inherit;

        font-size: 12px;

        outline: none;

        cursor: pointer;

        transition: var(--transition);
    }


    .task-filter-select:focus {
        border-color: var(--green-500);

        background: white;

        box-shadow:
            0 0 0 4px rgba(32, 184, 122, 0.10);
    }


    .filter-actions {
        display: flex;

        align-items: center;

        gap: 7px;
    }


    .filter-btn {
        height: 44px;

        padding: 0 15px;

        white-space: nowrap;
    }


    .filter-btn i {
        margin-right: 5px;
    }


    .clear-filter-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        height: 44px;

        padding: 0 11px;

        border-radius: 12px;

        color: var(--text-muted);

        text-decoration: none;

        font-size: 11px;
        font-weight: 600;

        transition: var(--transition);
    }


    .clear-filter-btn:hover {
        color: var(--green-700);

        background: var(--green-50);
    }


    /* ==============================
       List Header
    ============================== */

    .tasks-list-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        margin-bottom: 15px;
    }


    .tasks-list-header h3 {
        margin: 5px 0 0;

        color: var(--green-950);

        font-size: 20px;
        font-weight: 750;

        letter-spacing: -0.4px;
    }


    .task-count {
        padding: 6px 11px;

        border-radius: 999px;

        background: var(--green-100);

        color: var(--green-700);

        font-size: 10px;
        font-weight: 700;
    }


    /* ==============================
       Task Grid
    ============================== */

    .tasks-grid {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 16px;
    }


    /* ==============================
       Task Card
    ============================== */

    .task-card {
        position: relative;

        display: flex;
        flex-direction: column;

        min-height: 210px;

        padding: 20px;

        overflow: hidden;

        border-radius: 20px;

        background: white;

        border: 1px solid var(--border);

        box-shadow: var(--shadow-sm);

        text-decoration: none;

        transition:
            transform var(--transition),
            box-shadow var(--transition),
            border-color var(--transition);
    }


    .task-card:hover {
        transform: translateY(-5px);

        border-color:
            rgba(18, 166, 111, 0.20);

        box-shadow: var(--shadow-md);
    }


    .task-card::after {
        content: "";

        position: absolute;

        width: 120px;
        height: 120px;

        right: -70px;
        bottom: -70px;

        border-radius: 50%;

        background:
            rgba(32, 184, 122, 0.05);

        transition: var(--transition);
    }


    .task-card:hover::after {
        transform: scale(1.5);

        background:
            rgba(32, 184, 122, 0.08);
    }


    .task-card-top {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .task-status-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;

        font-size: 17px;
    }


    .status-pending {
        color: #9b7418;
        background: #fff6d9;
    }


    .status-inprogress {
        color: #2468a6;
        background: #e5f2ff;
    }


    .status-completed {
        color: var(--green-700);
        background: var(--green-100);
    }


    .status-cancelled {
        color: #a64c5d;
        background: #ffe8ed;
    }


    /* ==============================
       Priority
    ============================== */

    .task-priority {
        padding: 6px 10px;

        border-radius: 999px;

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 0.3px;
    }


    .priority-low {
        color: #28745a;
        background: #e8f7ef;
    }


    .priority-medium {
        color: #80651d;
        background: #fff6d9;
    }


    .priority-high {
        color: #a64c3c;
        background: #ffe9e4;
    }


    .priority-urgent {
        color: #9d3155;
        background: #ffe4ed;
    }


    /* ==============================
       Card Body
    ============================== */

    .task-card-body {
        position: relative;
        z-index: 2;

        flex: 1;

        padding-top: 18px;
    }


    .task-card-body h4 {
        margin: 0 0 7px;

        color: var(--green-950);

        font-size: 16px;
        font-weight: 750;

        line-height: 1.35;
    }


    .task-card-body p {
        display: -webkit-box;

        margin: 0;

        color: var(--text-muted);

        font-size: 11px;

        line-height: 1.6;

        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;

        overflow: hidden;
    }


    .task-card-body .no-description {
        color: #a0ada7;

        font-style: italic;
    }


    /* ==============================
       Card Footer
    ============================== */

    .task-card-footer {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding-top: 16px;

        margin-top: 14px;

        border-top:
            1px solid rgba(12, 91, 62, 0.07);
    }


    .task-status-text {
        color: var(--text-muted);

        font-size: 10px;
        font-weight: 700;
    }


    .task-due-date {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        color: var(--text-muted);

        font-size: 10px;
    }


    .task-due-date i {
        color: var(--green-600);
    }


    .task-due-date.muted {
        color: #a0ada7;
    }


    /* ==============================
       Arrow
    ============================== */

    .task-card-arrow {
        position: absolute;

        right: 17px;
        bottom: 15px;

        opacity: 0;

        color: var(--green-600);

        font-size: 14px;

        transform: translate(-4px, 4px);

        transition: var(--transition);

        z-index: 3;
    }


    .task-card:hover .task-card-arrow {
        opacity: 1;

        transform: translate(0, 0);
    }


    /* ==============================
       Empty State
    ============================== */

    .tasks-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        min-height: 330px;

        padding: 40px;

        text-align: center;

        border-radius: 22px;

        background: white;

        border: 1px solid var(--border);

        box-shadow: var(--shadow-sm);
    }


    .empty-task-icon {
        width: 68px;
        height: 68px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 17px;

        border-radius: 20px;

        background: var(--green-100);

        color: var(--green-600);

        font-size: 28px;
    }


    .tasks-empty-state h3 {
        margin: 0 0 7px;

        color: var(--green-950);

        font-size: 19px;
        font-weight: 750;
    }


    .tasks-empty-state p {
        margin: 0 0 20px;

        color: var(--text-muted);

        font-size: 12px;
    }


    /* ==============================
       Responsive
    ============================== */

    @@media (max-width: 1200px) {

        .filter-grid {
            grid-template-columns:
                1fr 1fr 1fr;
        }

        .filter-search {
            grid-column: span 3;
        }

        .filter-actions {
            grid-column: span 3;
        }

        .tasks-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

    }


    @@media (max-width: 767px) {

        .tasks-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .create-task-btn {
            width: 100%;
            justify-content: center;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .filter-search,
        .filter-actions {
            grid-column: auto;
        }

        .filter-actions {
            width: 100%;
        }

        .filter-btn {
            flex: 1;
        }

        .clear-filter-btn {
            padding: 0 15px;
        }

        .tasks-grid {
            grid-template-columns: 1fr;
        }

        .tasks-header h2 {
            font-size: 29px;
        }

    }

</style>