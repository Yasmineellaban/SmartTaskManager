@model SmartTaskManager.Models.TaskItem

@{
    ViewData["Title"] = "Create Task";
}

<div class="create-task-page">

    <div class="create-header">

        <div>
            <span class="create-eyebrow">
                TASK MANAGEMENT
            </span>

            <h2>
                Create a New Task
            </h2>

            <p>
                Turn your next idea into an organized action.
            </p>
        </div>

        <a asp-action="Index"
           class="back-link">

            <i class="bi bi-arrow-left"></i>

            Back to My Tasks

        </a>

    </div>


    <div class="row g-4">

        <div class="col-lg-8">

            <div class="create-card">

                <div class="create-card-header">

                    <div class="create-card-icon">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <div>
                        <h3>
                            Task Information
                        </h3>

                        <p>
                            Add the details you need to stay organized.
                        </p>
                    </div>

                </div>


                <form asp-action="Create"
                      method="post">

                    <div asp-validation-summary="All"
                         class="validation-summary">
                    </div>


                    <div class="form-field">

                        <label asp-for="Title">
                            Task Title
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-pencil"></i>

                            <input asp-for="Title"
                                   class="premium-input"
                                   placeholder="e.g. Complete C# assignment" />

                        </div>

                        <span asp-validation-for="Title"
                              class="field-error">
                        </span>

                    </div>


                    <div class="form-field">

                        <label asp-for="Description">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="premium-textarea"
                                  rows="5"
                                  placeholder="Add more details about this task..."></textarea>

                        <span asp-validation-for="Description"
                              class="field-error">
                        </span>

                    </div>


                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="form-field">

                                <label asp-for="Priority">
                                    Priority
                                </label>

                                <div class="select-wrapper">

                                    <i class="bi bi-flag"></i>

                                    <select asp-for="Priority"
                                            class="premium-select"
                                            asp-items="Html.GetEnumSelectList<SmartTaskManager.Models.TaskPriority>()">
                                    </select>

                                </div>

                                <span asp-validation-for="Priority"
                                      class="field-error">
                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-field">

                                <label asp-for="DueDate">
                                    Due Date
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-calendar3"></i>

                                    <input asp-for="DueDate"
                                           type="datetime-local"
                                           class="premium-input" />

                                </div>

                                <span asp-validation-for="DueDate"
                                      class="field-error">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="form-field">

                        <label asp-for="CategoryId">
                            Category
                        </label>

                        <div class="select-wrapper">

                            <i class="bi bi-folder2-open"></i>

                            <select asp-for="CategoryId"
                                    class="premium-select">

                                <option value="">
                                    Select Category
                                </option>

                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <span asp-validation-for="CategoryId"
                              class="field-error">
                        </span>

                    </div>


                    <div class="create-form-footer">

                        <a asp-action="Index"
                           class="cancel-btn">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary create-submit-btn">

                            <i class="bi bi-check2"></i>

                            Create Task

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="create-info-card">

                <div class="info-glow"></div>

                <div class="info-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <span class="info-eyebrow">
                    SMART WORKFLOW
                </span>

                <h3>
                    Stay one step ahead.
                </h3>

                <p>
                    Add a clear title, choose the right priority,
                    and set a due date to keep your work moving.
                </p>


                <div class="info-tips">

                    <div class="info-tip">

                        <span class="tip-number">
                            01
                        </span>

                        <span>
                            Give your task a clear title.
                        </span>

                    </div>


                    <div class="info-tip">

                        <span class="tip-number">
                            02
                        </span>

                        <span>
                            Set a priority based on importance.
                        </span>

                    </div>


                    <div class="info-tip">

                        <span class="tip-number">
                            03
                        </span>

                        <span>
                            Add a due date when timing matters.
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .create-task-page {
        width: 100%;
    }


    .create-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 28px;
    }


    .create-eyebrow {
        display: block;
        color: var(--green-700);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }


    .create-header h2 {
        margin: 7px 0 5px;
        color: var(--green-950);
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -1px;
    }


    .create-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
    }


    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--green-700);
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: var(--transition);
    }


    .back-link:hover {
        color: var(--green-900);
        transform: translateX(-3px);
    }


    .create-card {
        padding: 30px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.90);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(12px);
    }


    .create-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 24px;
        margin-bottom: 25px;
        border-bottom: 1px solid rgba(12, 91, 62, 0.08);
    }


    .create-card-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        background: var(--green-100);
        color: var(--green-700);
        font-size: 19px;
    }


    .create-card-header h3 {
        margin: 0;
        color: var(--green-950);
        font-size: 18px;
        font-weight: 750;
    }


    .create-card-header p {
        margin: 4px 0 0;
        color: var(--text-muted);
        font-size: 11px;
    }


    .form-field {
        margin-bottom: 21px;
    }


    .form-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--text-main);
        font-size: 11px;
        font-weight: 750;
    }


    .input-wrapper,
    .select-wrapper {
        position: relative;
    }


    .input-wrapper > i,
    .select-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--green-600);
        font-size: 14px;
        z-index: 2;
        pointer-events: none;
    }


    .premium-input,
    .premium-select,
    .premium-textarea {
        width: 100%;
        border: 1px solid rgba(12, 91, 62, 0.13);
        border-radius: 12px;
        background: var(--surface-soft);
        color: var(--text-main);
        font-family: inherit;
        font-size: 12px;
        outline: none;
        transition:
            border-color var(--transition),
            box-shadow var(--transition),
            background var(--transition);
    }


    .premium-input,
    .premium-select {
        height: 46px;
        padding: 0 13px 0 40px;
    }


    .premium-textarea {
        display: block;
        min-height: 120px;
        padding: 13px;
        resize: vertical;
    }


    .premium-input::placeholder,
    .premium-textarea::placeholder {
        color: #a2afa9;
    }


    .premium-input:focus,
    .premium-select:focus,
    .premium-textarea:focus {
        border-color: var(--green-500);
        background: white;
        box-shadow: 0 0 0 4px rgba(32, 184, 122, 0.10);
    }


    .premium-select {
        appearance: auto;
    }


    .field-error {
        display: block;
        margin-top: 5px;
        color: #b05245;
        font-size: 10px;
    }


    .validation-summary {
        margin-bottom: 18px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #fff1ef;
        color: #a64c3c;
        font-size: 11px;
    }


    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none;
    }


    .create-form-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1px solid rgba(12, 91, 62, 0.08);
    }


    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 17px;
        border-radius: 12px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: var(--transition);
    }


    .cancel-btn:hover {
        background: var(--green-50);
        color: var(--green-700);
    }


    .create-submit-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 44px;
        padding: 0 19px;
    }


    .create-info-card {
        position: relative;
        height: 100%;
        min-height: 400px;
        overflow: hidden;
        padding: 30px;
        border-radius: 22px;
        background: linear-gradient(
            145deg,
            var(--green-950),
            var(--green-900)
        );
        color: white;
        box-shadow: 0 20px 45px rgba(5, 72, 48, 0.18);
    }


    .info-glow {
        position: absolute;
        width: 230px;
        height: 230px;
        right: -100px;
        top: -100px;
        border-radius: 50%;
        background: rgba(82, 214, 156, 0.14);
        filter: blur(5px);
    }


    .create-info-card::after {
        content: "";
        position: absolute;
        width: 170px;
        height: 170px;
        left: -100px;
        bottom: -100px;
        border-radius: 50%;
        background: rgba(32, 184, 122, 0.12);
        pointer-events: none;
    }


    .create-info-card > *:not(.info-glow) {
        position: relative;
        z-index: 2;
    }


    .info-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        border-radius: 15px;
        background: rgba(140, 232, 189, 0.13);
        color: var(--green-300);
        font-size: 21px;
        box-shadow: inset 0 0 0 1px rgba(140, 232, 189, 0.10);
    }


    .info-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: var(--green-300);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }


    .create-info-card h3 {
        max-width: 280px;
        margin: 0 0 12px;
        color: white;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.7px;
    }


    .create-info-card > p {
        max-width: 320px;
        margin: 0;
        color: rgba(255, 255, 255, 0.62);
        font-size: 12px;
        line-height: 1.7;
    }


    .info-tips {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 30px;
    }


    .info-tip {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px;
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.72);
        font-size: 10px;
    }


    .tip-number {
        color: var(--green-300);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }


    @@media (max-width: 767px) {

        .create-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .create-header h2 {
            font-size: 29px;
        }

        .create-card {
            padding: 22px;
        }

        .create-info-card {
            min-height: auto;
        }

        .create-form-footer {
            justify-content: stretch;
        }

        .cancel-btn,
        .create-submit-btn {
            flex: 1;
        }

    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}