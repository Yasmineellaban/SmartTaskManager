@model SmartTaskManager.Models.TaskItem

@{
    ViewData["Title"] = "Edit Task";
}

<div class="edit-task-page">

    <div class="edit-header">

        <div>
            <span class="edit-eyebrow">
                TASK MANAGEMENT
            </span>

            <h2>
                Edit Task
            </h2>

            <p>
                Update your task details and keep your workflow on track.
            </p>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="back-link">

            <i class="bi bi-arrow-left"></i>

            Back to Details

        </a>

    </div>


    <div class="row g-4">

        <div class="col-lg-8">

            <div class="edit-card">

                <div class="edit-card-header">

                    <div class="edit-card-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                    <div>
                        <h3>
                            Task Information
                        </h3>

                        <p>
                            Make the changes you need to your task.
                        </p>
                    </div>

                </div>


                <form asp-action="Edit"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />


                    <div asp-validation-summary="All"
                         class="validation-summary">
                    </div>


                    <div class="form-field">

                        <label asp-for="Title">
                            Task Title
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-pencil"></i>

                            <input asp-for="Title"
                                   class="premium-input"
                                   placeholder="Enter task title" />

                        </div>

                        <span asp-validation-for="Title"
                              class="field-error">
                        </span>

                    </div>


                    <div class="form-field">

                        <label asp-for="Description">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="premium-textarea"
                                  rows="5"
                                  placeholder="Add details about this task..."></textarea>

                        <span asp-validation-for="Description"
                              class="field-error">
                        </span>

                    </div>


                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="form-field">

                                <label asp-for="Priority">
                                    Priority
                                </label>

                                <div class="select-wrapper">

                                    <i class="bi bi-flag"></i>

                                    <select asp-for="Priority"
                                            class="premium-select"
                                            asp-items="Html.GetEnumSelectList<SmartTaskManager.Models.TaskPriority>()">
                                    </select>

                                </div>

                                <span asp-validation-for="Priority"
                                      class="field-error">
                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-field">

                                <label asp-for="Status">
                                    Status
                                </label>

                                <div class="select-wrapper">

                                    <i class="bi bi-circle-half"></i>

                                    <select asp-for="Status"
                                            class="premium-select"
                                            asp-items="Html.GetEnumSelectList<SmartTaskManager.Models.TaskStatus>()">
                                    </select>

                                </div>

                                <span asp-validation-for="Status"
                                      class="field-error">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="form-field">

                                <label asp-for="DueDate">
                                    Due Date
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-calendar3"></i>

                                    <input asp-for="DueDate"
                                           type="datetime-local"
                                           class="premium-input" />

                                </div>

                                <span asp-validation-for="DueDate"
                                      class="field-error">
                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-field">

                                <label asp-for="CategoryId">
                                    Category
                                </label>

                                <div class="select-wrapper">

                                    <i class="bi bi-folder2-open"></i>

                                    <select asp-for="CategoryId"
                                            class="premium-select">

                                        <option value="">
                                            Select Category
                                        </option>

                                        @foreach (var category in ViewBag.Categories)
                                        {
                                            <option value="@category.Id">
                                                @category.Name
                                            </option>
                                        }

                                    </select>

                                </div>

                                <span asp-validation-for="CategoryId"
                                      class="field-error">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="edit-form-footer">

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="cancel-btn">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary save-btn">

                            <i class="bi bi-check2"></i>

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="edit-info-card">

                <div class="info-glow"></div>

                <div class="info-icon">
                    <i class="bi bi-sliders"></i>
                </div>

                <span class="info-eyebrow">
                    TASK CONTROL
                </span>

                <h3>
                    Keep your tasks up to date.
                </h3>

                <p>
                    Adjust the status, priority, category, or deadline
                    whenever your plan changes.
                </p>


                <div class="edit-status-card">

                    <span class="mini-label">
                        CURRENT TASK
                    </span>

                    <div class="current-task">

                        <div class="current-task-icon">
                            <i class="bi bi-check2"></i>
                        </div>

                        <div>
                            <strong>
                                @Model.Title
                            </strong>

                            <span>
                                @Model.Status
                            </span>
                        </div>

                    </div>

                </div>


                <div class="edit-tip">

                    <i class="bi bi-lightbulb"></i>

                    <span>
                        Keep your status updated to get more accurate
                        progress information on your dashboard.
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .edit-task-page {
        width: 100%;
    }


    .edit-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 28px;
    }


    .edit-eyebrow {
        display: block;
        color: var(--green-700);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }


    .edit-header h2 {
        margin: 7px 0 5px;
        color: var(--green-950);
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -1px;
    }


    .edit-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 13px;
    }


    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--green-700);
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: var(--transition);
    }


    .back-link:hover {
        color: var(--green-900);
        transform: translateX(-3px);
    }


    .edit-card {
        padding: 30px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.90);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(12px);
    }


    .edit-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 24px;
        margin-bottom: 25px;
        border-bottom: 1px solid rgba(12, 91, 62, 0.08);
    }


    .edit-card-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        background: var(--green-100);
        color: var(--green-700);
        font-size: 19px;
    }


    .edit-card-header h3 {
        margin: 0;
        color: var(--green-950);
        font-size: 18px;
        font-weight: 750;
    }


    .edit-card-header p {
        margin: 4px 0 0;
        color: var(--text-muted);
        font-size: 11px;
    }


    .form-field {
        margin-bottom: 21px;
    }


    .form-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--text-main);
        font-size: 11px;
        font-weight: 750;
    }


    .input-wrapper,
    .select-wrapper {
        position: relative;
    }


    .input-wrapper > i,
    .select-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--green-600);
        font-size: 14px;
        z-index: 2;
        pointer-events: none;
    }


    .premium-input,
    .premium-select,
    .premium-textarea {
        width: 100%;
        border: 1px solid rgba(12, 91, 62, 0.13);
        border-radius: 12px;
        background: var(--surface-soft);
        color: var(--text-main);
        font-family: inherit;
        font-size: 12px;
        outline: none;
        transition:
            border-color var(--transition),
            box-shadow var(--transition),
            background var(--transition);
    }


    .premium-input,
    .premium-select {
        height: 46px;
        padding: 0 13px 0 40px;
    }


    .premium-textarea {
        display: block;
        min-height: 120px;
        padding: 13px;
        resize: vertical;
    }


    .premium-input::placeholder,
    .premium-textarea::placeholder {
        color: #a2afa9;
    }


    .premium-input:focus,
    .premium-select:focus,
    .premium-textarea:focus {
        border-color: var(--green-500);
        background: white;
        box-shadow: 0 0 0 4px rgba(32, 184, 122, 0.10);
    }


    .premium-select {
        appearance: auto;
    }


    .field-error {
        display: block;
        margin-top: 5px;
        color: #b05245;
        font-size: 10px;
    }


    .validation-summary {
        margin-bottom: 18px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #fff1ef;
        color: #a64c3c;
        font-size: 11px;
    }


    .validation-summary:empty,
    .validation-summary.validation-summary-valid {
        display: none;
    }


    .edit-form-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1px solid rgba(12, 91, 62, 0.08);
    }


    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 17px;
        border-radius: 12px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: var(--transition);
    }


    .cancel-btn:hover {
        background: var(--green-50);
        color: var(--green-700);
    }


    .save-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 44px;
        padding: 0 19px;
    }


    .edit-info-card {
        position: relative;
        height: 100%;
        min-height: 400px;
        overflow: hidden;
        padding: 30px;
        border-radius: 22px;
        background: linear-gradient(
            145deg,
            var(--green-950),
            var(--green-900)
        );
        color: white;
        box-shadow: 0 20px 45px rgba(5, 72, 48, 0.18);
    }


    .info-glow {
        position: absolute;
        width: 230px;
        height: 230px;
        right: -100px;
        top: -100px;
        border-radius: 50%;
        background: rgba(82, 214, 156, 0.14);
        filter: blur(5px);
    }


    .edit-info-card::after {
        content: "";
        position: absolute;
        width: 170px;
        height: 170px;
        left: -100px;
        bottom: -100px;
        border-radius: 50%;
        background: rgba(32, 184, 122, 0.12);
        pointer-events: none;
    }


    .edit-info-card > *:not(.info-glow) {
        position: relative;
        z-index: 2;
    }


    .info-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        border-radius: 15px;
        background: rgba(140, 232, 189, 0.13);
        color: var(--green-300);
        font-size: 21px;
        box-shadow: inset 0 0 0 1px rgba(140, 232, 189, 0.10);
    }


    .info-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: var(--green-300);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }


    .edit-info-card h3 {
        max-width: 280px;
        margin: 0 0 12px;
        color: white;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.7px;
    }


    .edit-info-card > p {
        max-width: 320px;
        margin: 0;
        color: rgba(255, 255, 255, 0.62);
        font-size: 12px;
        line-height: 1.7;
    }


    .edit-status-card {
        margin-top: 28px;
        padding: 14px;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }


    .mini-label {
        display: block;
        margin-bottom: 10px;
        color: var(--green-300);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }


    .current-task {
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .current-task-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: rgba(82, 214, 156, 0.12);
        color: var(--green-300);
    }


    .current-task strong {
        display: block;
        max-width: 200px;
        overflow: hidden;
        color: white;
        font-size: 11px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .current-task span {
        display: block;
        margin-top: 3px;
        color: rgba(255, 255, 255, 0.48);
        font-size: 9px;
    }


    .edit-tip {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 15px;
        padding: 12px;
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.55);
        font-size: 9px;
        line-height: 1.6;
    }


    .edit-tip i {
        color: var(--green-300);
        font-size: 13px;
        margin-top: 1px;
    }


    @@media (max-width: 767px) {

        .edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .edit-header h2 {
            font-size: 29px;
        }

        .edit-card {
            padding: 22px;
        }

        .edit-info-card {
            min-height: auto;
        }

        .edit-form-footer {
            justify-content: stretch;
        }

        .cancel-btn,
        .save-btn {
            flex: 1;
        }

    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}