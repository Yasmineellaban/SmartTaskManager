@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- Welcome Section -->
    <div class="dashboard-hero mb-4">

        <div>
            <span class="dashboard-eyebrow">
                YOUR WORKSPACE
            </span>

            <h2 class="dashboard-title">
                Stay focused.<br />
                Get things done.
            </h2>

            <p class="dashboard-subtitle">
                Manage your tasks, track your progress,
                and let SmartTaskManager keep everything organized.
            </p>
        </div>

        <div class="dashboard-hero-action">
            <a asp-controller="Tasks"
               asp-action="Create"
               class="btn btn-primary dashboard-create-btn">
                <i class="bi bi-plus-lg"></i>
                Create New Task
            </a>
        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="stat-icon stat-icon-green">
                    <i class="bi bi-check2-square"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        TOTAL TASKS
                    </span>

                    <strong class="stat-value">
                        @ViewBag.TotalTasks
                    </strong>

                    <span class="stat-description">
                        All your tasks
                    </span>
                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="stat-icon stat-icon-yellow">
                    <i class="bi bi-clock"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        PENDING
                    </span>

                    <strong class="stat-value">
                        @ViewBag.PendingTasks
                    </strong>

                    <span class="stat-description">
                        Waiting to start
                    </span>
                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="stat-icon stat-icon-blue">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        IN PROGRESS
                    </span>

                    <strong class="stat-value">
                        @ViewBag.InProgressTasks
                    </strong>

                    <span class="stat-description">
                        Currently active
                    </span>
                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="stat-icon stat-icon-purple">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        COMPLETED
                    </span>

                    <strong class="stat-value">
                        @ViewBag.CompletedTasks
                    </strong>

                    <span class="stat-description">
                        Successfully finished
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- Productivity Overview -->
    <div class="row g-4 mb-4">

        <!-- Completion Rate -->
        <div class="col-lg-8">

            <div class="dashboard-panel completion-panel">

                <div class="panel-header">

                    <div>
                        <span class="panel-eyebrow">
                            PRODUCTIVITY
                        </span>

                        <h3>
                            Completion Overview
                        </h3>
                    </div>

                    <div class="completion-percentage">
                        @ViewBag.CompletionRate%
                    </div>

                </div>


                <div class="completion-progress-wrapper">

                    <div class="completion-progress">

                        <div class="completion-progress-bar"
                             style="width: @ViewBag.CompletionRate%;">
                        </div>

                    </div>

                </div>


                <div class="completion-footer">

                    <span>
                        <i class="bi bi-check-circle-fill"></i>
                        Completed tasks
                    </span>

                    <span>
                        @ViewBag.CompletedTasks of
                        @ViewBag.TotalTasks tasks
                    </span>

                </div>

            </div>

        </div>


        <!-- Overdue -->
        <div class="col-lg-4">

            <div class="dashboard-panel overdue-panel">

                <div class="overdue-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <div class="overdue-content">

                    <span class="panel-eyebrow">
                        ATTENTION
                    </span>

                    <h3>
                        @ViewBag.OverdueTasks
                    </h3>

                    <p>
                        Overdue
                        @(ViewBag.OverdueTasks == 1 ? "task" : "tasks")
                    </p>

                </div>

                <a asp-controller="Tasks"
                   asp-action="Index"
                   class="overdue-link">
                    View tasks
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>


    <!-- Recent Tasks -->
    <div class="dashboard-panel recent-panel">

        <div class="panel-header">

            <div>
                <span class="panel-eyebrow">
                    ACTIVITY
                </span>

                <h3>
                    Recent Tasks
                </h3>
            </div>

            <a asp-controller="Tasks"
               asp-action="Index"
               class="view-all-link">
                View all
                <i class="bi bi-arrow-up-right"></i>
            </a>

        </div>


        @if (ViewBag.RecentTasks.Count == 0)
        {
            <div class="empty-dashboard">

                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <h4>
                    No tasks yet
                </h4>

                <p>
                    Create your first task and start organizing your work.
                </p>

                <a asp-controller="Tasks"
                   asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Create Task
                </a>

            </div>
        }
        else
        {
            <div class="recent-task-list">

                @foreach (var task in ViewBag.RecentTasks)
                {
                    <a asp-controller="Tasks"
                       asp-action="Details"
                       asp-route-id="@task.Id"
                       class="recent-task">

                        <div class="recent-task-icon">
                            <i class="bi bi-check2"></i>
                        </div>


                        <div class="recent-task-info">

                            <strong>
                                @task.Title
                            </strong>

                            <span>
                                @task.Status
                            </span>

                        </div>


                        <div class="recent-task-meta">

                            <span class="task-priority priority-@task.Priority.ToString().ToLower()">
                                @task.Priority
                            </span>

                            <i class="bi bi-chevron-right task-arrow"></i>

                        </div>

                    </a>
                }

            </div>
        }

    </div>

</div>


<style>

    /* ==============================
       Dashboard
    ============================== */

    .dashboard-page {
        width: 100%;
    }


    /* ==============================
       Hero
    ============================== */

    .dashboard-hero {
        position: relative;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 38px 40px;

        border-radius: 26px;

        overflow: hidden;

        background:
            linear-gradient(
                135deg,
                #ffffff 0%,
                #f4fcf8 100%
            );

        border: 1px solid var(--border);

        box-shadow: var(--shadow-sm);
    }

    .dashboard-hero::before {
        content: "";

        position: absolute;

        width: 280px;
        height: 280px;

        border-radius: 50%;

        background:
            rgba(32, 184, 122, 0.08);

        right: -100px;
        top: -130px;

        filter: blur(5px);
    }

    .dashboard-hero::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        border-radius: 50%;

        background:
            rgba(140, 232, 189, 0.12);

        right: 180px;
        bottom: -120px;
    }


    .dashboard-hero > * {
        position: relative;
        z-index: 1;
    }


    .dashboard-eyebrow,
    .panel-eyebrow {
        display: block;

        color: var(--green-700);

        font-size: 10px;
        font-weight: 800;

        letter-spacing: 1.8px;
    }


    .dashboard-title {
        margin: 8px 0 10px;

        font-size: clamp(28px, 3vw, 42px);

        line-height: 1.12;

        font-weight: 800;

        letter-spacing: -1.5px;

        color: var(--green-950);
    }


    .dashboard-subtitle {
        max-width: 620px;

        margin: 0;

        color: var(--text-muted);

        font-size: 14px;

        line-height: 1.7;
    }


    .dashboard-create-btn {
        padding: 13px 20px;

        white-space: nowrap;
    }


    .dashboard-create-btn i {
        margin-right: 6px;
    }


    /* ==============================
       Statistics
    ============================== */

    .dashboard-stat-card {
        height: 100%;

        display: flex;
        align-items: center;

        gap: 16px;

        padding: 22px;

        border-radius: 20px;

        background: var(--surface);

        border: 1px solid var(--border);

        box-shadow: var(--shadow-sm);

        transition:
            transform var(--transition),
            box-shadow var(--transition),
            border-color var(--transition);
    }


    .dashboard-stat-card:hover {
        transform: translateY(-5px);

        box-shadow: var(--shadow-md);

        border-color:
            rgba(18, 166, 111, 0.18);
    }


    .stat-icon {
        width: 50px;
        height: 50px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 15px;

        font-size: 21px;
    }


    .stat-icon-green {
        color: var(--green-700);
        background: var(--green-100);
    }


    .stat-icon-yellow {
        color: #a46d00;
        background: #fff6d9;
    }


    .stat-icon-blue {
        color: #2468a6;
        background: #e5f2ff;
    }


    .stat-icon-purple {
        color: #7751a8;
        background: #f0e8ff;
    }


    .stat-content {
        min-width: 0;

        display: flex;
        flex-direction: column;
    }


    .stat-label {
        color: var(--text-muted);

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1.2px;
    }


    .stat-value {
        margin-top: 3px;

        color: var(--green-950);

        font-size: 28px;
        line-height: 1.1;

        font-weight: 800;
    }


    .stat-description {
        margin-top: 4px;

        color: var(--text-muted);

        font-size: 11px;
    }


    /* ==============================
       Panels
    ============================== */

    .dashboard-panel {
        height: 100%;

        padding: 28px;

        border-radius: 22px;

        background: rgba(255, 255, 255, 0.88);

        border: 1px solid var(--border);

        box-shadow: var(--shadow-sm);

        backdrop-filter: blur(12px);
    }


    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 24px;
    }


    .panel-header h3 {
        margin: 5px 0 0;

        color: var(--green-950);

        font-size: 20px;
        font-weight: 750;

        letter-spacing: -0.4px;
    }


    /* ==============================
       Completion
    ============================== */

    .completion-percentage {
        display: flex;
        align-items: center;
        justify-content: center;

        min-width: 66px;
        height: 40px;

        padding: 0 12px;

        border-radius: 12px;

        background: var(--green-100);

        color: var(--green-700);

        font-size: 16px;
        font-weight: 800;
    }


    .completion-progress-wrapper {
        padding: 10px 0;
    }


    .completion-progress {
        height: 12px;

        overflow: hidden;

        border-radius: 999px;

        background: var(--green-100);
    }


    .completion-progress-bar {
        height: 100%;

        border-radius: inherit;

        background:
            linear-gradient(
                90deg,
                var(--green-600),
                var(--green-400)
            );

        box-shadow:
            0 0 18px rgba(32, 184, 122, 0.25);

        transition: width 1s ease;
    }


    .completion-footer {
        display: flex;
        justify-content: space-between;

        margin-top: 18px;

        color: var(--text-muted);

        font-size: 12px;
    }


    .completion-footer i {
        margin-right: 5px;

        color: var(--green-600);
    }


    /* ==============================
       Overdue
    ============================== */

    .overdue-panel {
        position: relative;

        overflow: hidden;

        display: flex;
        flex-direction: column;
    }


    .overdue-panel::after {
        content: "";

        position: absolute;

        width: 150px;
        height: 150px;

        border-radius: 50%;

        right: -70px;
        bottom: -80px;

        background: rgba(255, 190, 80, 0.10);
    }


    .overdue-icon {
        width: 48px;
        height: 48px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background: #fff5dc;

        color: #c98500;

        font-size: 20px;
    }


    .overdue-content {
        margin-top: 18px;
    }


    .overdue-content h3 {
        margin: 4px 0 0;

        font-size: 32px;
        font-weight: 800;

        color: var(--green-950);
    }


    .overdue-content p {
        margin: 2px 0 0;

        color: var(--text-muted);

        font-size: 13px;
    }


    .overdue-link {
        position: relative;
        z-index: 2;

        display: inline-flex;
        align-items: center;
        gap: 7px;

        margin-top: auto;
        padding-top: 22px;

        color: var(--green-700);

        text-decoration: none;

        font-size: 12px;
        font-weight: 700;

        transition: var(--transition);
    }


    .overdue-link:hover {
        color: var(--green-900);

        transform: translateX(3px);
    }


    /* ==============================
       Recent Tasks
    ============================== */

    .recent-panel {
        min-height: 260px;
    }


    .view-all-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        color: var(--green-700);

        text-decoration: none;

        font-size: 12px;
        font-weight: 700;

        transition: var(--transition);
    }


    .view-all-link:hover {
        color: var(--green-900);

        transform: translateX(2px);
    }


    .recent-task-list {
        display: flex;
        flex-direction: column;

        gap: 8px;
    }


    .recent-task {
        display: flex;
        align-items: center;

        gap: 14px;

        padding: 14px 16px;

        border-radius: 15px;

        text-decoration: none;

        border: 1px solid transparent;

        background: var(--surface-soft);

        transition:
            transform var(--transition),
            background var(--transition),
            border-color var(--transition);
    }


    .recent-task:hover {
        transform: translateX(4px);

        background: var(--green-50);

        border-color: var(--green-200);
    }


    .recent-task-icon {
        width: 38px;
        height: 38px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 11px;

        background: var(--green-100);

        color: var(--green-700);
    }


    .recent-task-info {
        min-width: 0;

        flex: 1;

        display: flex;
        flex-direction: column;
        gap: 4px;
    }


    .recent-task-info strong {
        overflow: hidden;

        color: var(--text-main);

        font-size: 13px;
        font-weight: 700;

        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .recent-task-info span {
        color: var(--text-muted);

        font-size: 11px;
    }


    .recent-task-meta {
        display: flex;
        align-items: center;

        gap: 14px;
    }


    .task-priority {
        padding: 5px 9px;

        border-radius: 999px;

        font-size: 10px;
        font-weight: 700;
    }


    .priority-low {
        color: #28745a;
        background: #e8f7ef;
    }


    .priority-medium {
        color: #80651d;
        background: #fff6d9;
    }


    .priority-high {
        color: #a64c3c;
        background: #ffe9e4;
    }


    .priority-urgent {
        color: #9d3155;
        background: #ffe4ed;
    }


    .task-arrow {
        color: var(--text-muted);

        font-size: 12px;

        transition: var(--transition);
    }


    .recent-task:hover .task-arrow {
        color: var(--green-600);

        transform: translateX(3px);
    }


    /* ==============================
       Empty State
    ============================== */

    .empty-dashboard {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        padding: 30px;

        text-align: center;
    }


    .empty-icon {
        width: 60px;
        height: 60px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 14px;

        border-radius: 18px;

        background: var(--green-100);

        color: var(--green-600);

        font-size: 25px;
    }


    .empty-dashboard h4 {
        margin: 0 0 6px;

        color: var(--green-950);

        font-size: 17px;
        font-weight: 750;
    }


    .empty-dashboard p {
        margin: 0 0 18px;

        color: var(--text-muted);

        font-size: 12px;
    }


    /* ==============================
       Responsive
    ============================== */

    @@media (max-width: 767px) {

        .dashboard-hero {
            flex-direction: column;
            align-items: flex-start;

            gap: 25px;

            padding: 28px 24px;
        }

        .dashboard-title {
            font-size: 30px;
        }

        .dashboard-create-btn {
            width: 100%;
        }

        .dashboard-panel {
            padding: 22px;
        }

        .completion-footer {
            flex-direction: column;
            gap: 6px;
        }

        .recent-task-meta {
            gap: 7px;
        }

        .task-priority {
            display: none;
        }

    }

</style>